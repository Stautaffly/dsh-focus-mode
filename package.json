{
  "name": "dsh-focus-mode",
  "version": "0.1.2",
  "description": "An external focus-mode preset with persistent command tools and hybrid execution.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./exec": {
      "types": "./lib/exec.d.ts",
      "default": "./lib/exec.js"
    },
    "./hybrid": {
      "types": "./lib/hybrid.d.ts",
      "default": "./lib/hybrid.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.1-rc.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "prepack": "npm run build",
    "test:integration": "vitest run --config vitest.config.ts",
    "pack:release": "npm pack --pack-destination dist",
    "link:host": "node scripts/link-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.3",
    "@deepseek-ai/dsh-command-compact": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.3",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.3",
    "@deepseek-ai/dsh-terminal": "0.2.1-rc.3",
    "@deepseek-ai/dsh-terminal-bash": "0.2.1-rc.3",
    "@deepseek-ai/dsh-time-context": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-cordis": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-present": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-workflow": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/node": "24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stautaffly/dsh-focus-mode.git"
  },
  "homepage": "https://github.com/Stautaffly/dsh-focus-mode#readme",
  "bugs": {
    "url": "https://github.com/Stautaffly/dsh-focus-mode/issues"
  }
}
